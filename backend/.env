# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Ne jamais committer le fichier ".env" réel dans un dépôt Git.

# --- Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_notes
# Taille du pool de connexions MySQL et file d'attente (voir config/db.js).
# À ajuster selon la valeur de max_connections configurée côté serveur MySQL.
DB_CONNECTION_LIMIT=50
DB_QUEUE_LIMIT=200

# --- Serveur ---
PORT=1000
# URL de base où le frontend est servi (sans slash final), utilisée pour
# construire le lien de confirmation envoyé dans l'email de réinitialisation
# de mot de passe. Exemple en développement : http://localhost:5500
# Exemple en production : https://votre-domaine.mg
FRONTEND_URL=https://gnenset.vercel.app/

# --- Sécurité JWT ---
# Chaîne longue et aléatoire utilisée pour signer les tokens de session.
JWT_SECRET=ksdjejlasjwjdjsljwrhjsklkj-sjklsd-dfdddddgdg
JWT_EXPIRES_IN=1h

# --- Email automatique (SMTP) ---
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# Utilisez un mot de passe d'application, pas le mot de passe Gmail habituel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=zazagasymamiratra@gmail.com
SMTP_PASSWORD=lipsreiaoiqieffr
SMTP_FROM="Gestion de Notes <zazagasymamiratra@gmail.com>"
